# Optional build-time overrides (copy to `.env.local` — not committed).
# GitHub Pages / CI: set the same keys as repository or workflow env vars.

# Asset base path (default `/` for the 2lakes.app custom domain)
# VITE_BASE=/

# Public Worker API (default: live workers.dev host)
# VITE_API_BASE=https://2lakes-api.brandon-pliska-86a.workers.dev

# King County URL override (optional). Defaults:
#   - Capacitor native → direct green2.kingcounty.gov (no CORS)
#   - Web / `pnpm dev` → /api/kc (Vite proxy only; absent on GitHub Pages)
# Plain browsers on GitHub Pages cannot call King County (no CORS) — they use Worker/IDB.
# VITE_KC_PROXY_URL=/api/kc

# Voluntary donations — external HTTPS link (Ko-fi, Buy Me a Coffee, GitHub Sponsors, PayPal, …)
# When unset, the Donate entry is hidden in Settings.
VITE_DONATE_URL=""
