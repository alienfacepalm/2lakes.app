# Optional build-time overrides (copy to `.env.local` — not committed).
# Cloudflare Pages: set the same keys under Project → Settings → Environment variables.

# King County proxy (default: /api/kc on same origin)
# VITE_KC_PROXY_URL=/api/kc

# Voluntary donations — external HTTPS link (Ko-fi, Buy Me a Coffee, GitHub Sponsors, PayPal, …)
# When unset, the Donate entry is hidden in Settings.
VITE_DONATE_URL=""
